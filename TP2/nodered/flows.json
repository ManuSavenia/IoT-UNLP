[
    {
        "id": "tab-iot-ambiente",
        "type": "tab",
        "label": "Monitoreo Ambiental",
        "disabled": false,
        "info": "Flujo: MQTT -> JSON -> InfluxDB"
    },
    {
        "id": "mqtt-broker-config",
        "type": "mqtt-broker",
        "name": "Mosquitto",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "nodered-iot",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "sessionExpiry": ""
    },
    {
        "id": "influxdb-config",
        "type": "influxdb",
        "name": "InfluxDB Local",
        "influxdbVersion": "2.0",
        "url": "http://influxdb:8086",
        "rejectUnauthorized": false,
        "token": "iot-token-123456",
        "timeout": 10
    },
    {
        "id": "node-mqtt-in",
        "type": "mqtt in",
        "z": "tab-iot-ambiente",
        "name": "sensor/ambiente",
        "topic": "sensor/ambiente",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "mqtt-broker-config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 160,
        "wires": [["node-json", "node-debug-raw"]]
    },
    {
        "id": "node-debug-raw",
        "type": "debug",
        "z": "tab-iot-ambiente",
        "name": "Debug RAW (mensaje MQTT)",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 370,
        "y": 260,
        "wires": []
    },
    {
        "id": "node-json",
        "type": "json",
        "z": "tab-iot-ambiente",
        "name": "Parsear JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 320,
        "y": 160,
        "wires": [["node-function"]]
    },
    {
        "id": "node-function",
        "type": "function",
        "z": "tab-iot-ambiente",
        "name": "Preparar para InfluxDB",
        "func": "const temp = parseFloat(msg.payload.temperature);\nconst hum  = parseFloat(msg.payload.humidity);\n\nif (isNaN(temp) || isNaN(hum)) {\n    node.warn('Datos inválidos: ' + JSON.stringify(msg.payload));\n    return null;\n}\n\nmsg.payload = [{ temperature: temp, humidity: hum }];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 160,
        "wires": [["node-influxdb-out", "node-debug-pre-influx"]]
    },
    {
        "id": "node-debug-pre-influx",
        "type": "debug",
        "z": "tab-iot-ambiente",
        "name": "Debug pre-InfluxDB (payload formateado)",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 790,
        "y": 200,
        "wires": []
    },
    {
        "id": "node-influxdb-out",
        "type": "influxdb out",
        "z": "tab-iot-ambiente",
        "influxdb": "influxdb-config",
        "name": "Guardar en InfluxDB",
        "measurement": "ambiente",
        "precision": "ms",
        "retentionPolicy": "",
        "org": "iot-org",
        "bucket": "iot",
        "x": 790,
        "y": 140,
        "wires": []
    },
    {
        "id": "node-influxdb-catch",
        "type": "catch",
        "z": "tab-iot-ambiente",
        "name": "Catch errores InfluxDB",
        "scope": ["node-influxdb-out"],
        "uncaught": false,
        "x": 560,
        "y": 340,
        "wires": [["node-debug-errors"]]
    },
    {
        "id": "node-debug-errors",
        "type": "debug",
        "z": "tab-iot-ambiente",
        "name": "ERROR InfluxDB",
        "active": true,
        "tosidebar": true,
        "console": true,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 790,
        "y": 340,
        "wires": []
    }
]
